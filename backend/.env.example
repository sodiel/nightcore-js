# Choose one option, or leave both commented out.
# Cookies file:
# YT_DLP_COOKIES_PATH=/absolute/path/to/cookies.txt
# yt-dlp browser specification, including optional profile path:
# YT_DLP_COOKIES_FROM_BROWSER=firefox:/absolute/path/to/firefox/profile
# Optional: use the same User-Agent as the browser supplying cookies.
# YT_DLP_USER_AGENT="Mozilla/5.0 ..."
