# Defaults
# HOST=127.0.0.1
# PORT=3001
# TRACKS_DIR=./tracks

# Set these when the tools are outside PATH.
# YT_DLP_BIN=./yt-dlp
# FFMPEG_BIN=/absolute/path/to/ffmpeg
# FFPROBE_BIN=/absolute/path/to/ffprobe

# Optional public URL used by the legacy /process API.
# PUBLIC_ORIGIN=http://localhost:3001

# Optional native loopback-only YouTube authentication. Read the warning in README.
# YT_DLP_LOCAL_AUTH=1
# YT_DLP_COOKIES_FROM_BROWSER=firefox
# Alternative to browser mode. Do not set both options.
# YT_DLP_COOKIES_PATH=/absolute/path/to/private/cookies.txt
# YT_DLP_USER_AGENT="Mozilla/5.0 ..."
